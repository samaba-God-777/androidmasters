{
  "name": "androidmasters",
  "private": true,
  "version": "1.0.0",
  "description": "AndroidMasters — plataforma profesional de diagnóstico y gestión autorizada de dispositivos Android",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
